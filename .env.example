# Copia este archivo a .env con:  python3 scripts/generar_env.py
# (genera claves NUEVAS; nunca reutilices las de otro proyecto). .env jamás se sube a git.

# --- Base de datos (docker compose usa estos valores para crear Postgres)
POSTGRES_USER=control
POSTGRES_PASSWORD=__GENERADA__
POSTGRES_DB=control_clientes
DB_PORT=5434
# Para correr migraciones/seed/pruebas FUERA de docker (host=localhost). Dentro de docker compose se sobrescribe con host=db.
DATABASE_URL=postgresql+psycopg2://control:__GENERADA__@localhost:5434/control_clientes

# --- Seguridad
JWT_SECRET=__GENERADA__
AES_KEY_B64=__GENERADA__
JOBS_SECRET=__GENERADA__

# --- App
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TZ=America/Mexico_City
SEED_ON_START=false
# ENABLE_DOCS=true   # solo en desarrollo: documentación interactiva de la API en /docs
